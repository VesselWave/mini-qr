{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-qr",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "qr.vwave.me", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
